# Plant Talk configuration. `npm run setup` copies this file to .env.

# Which AI backend to use:
#   local  - local models through an OpenAI-compatible server (Ollama, LM Studio). No API key, no API bill.
#   openai - the OpenAI API (gpt-5.4 vision + Realtime voice). Needs OPENAI_API_KEY below.
AI_PROVIDER=local

# --- Local models (AI_PROVIDER=local) ---
# Ollama's OpenAI-compatible endpoint. LM Studio's default is http://127.0.0.1:1234/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# A vision-capable model for observations. Pull it first: ollama pull qwen2.5vl:7b
# Smaller/faster: qwen2.5vl:3b   Larger/better: qwen2.5vl:32b
LOCAL_VISION_MODEL=qwen2.5vl:7b
# Model for the voice conversation. Leave empty to reuse the vision model.
LOCAL_CHAT_MODEL=
# Optional: an OpenAI-compatible Whisper server (e.g. speaches) for fully offline
# speech recognition. Leave empty to use the browser's built-in recognition
# (Chrome/Edge send that audio to their cloud speech service).
LOCAL_STT_BASE_URL=
LOCAL_STT_MODEL=Systran/faster-whisper-small

# --- OpenAI (AI_PROVIDER=openai) ---
# Get one at https://platform.openai.com/api-keys. Do not paste your API key into chat.
OPENAI_API_KEY=replace-me

# --- Server ---
# The API has no login, so it only listens on this computer by default.
# Set HOST=0.0.0.0 only if you trust everyone on your network.
# HOST=127.0.0.1
